    {"id":"compare_text","type":"text","x":68,"y":410,"width":430,"height":128,"angle":0,"strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["compare"],"frameId":null,"roundness":null,"seed":76204,"version":1,"versionNonce":86204,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"3. Compare by lining up places\n0.305 < 0.350\nMore decimal digits does not always mean bigger.","fontSize":21,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. Compare by lining up places\n0.305 < 0.350\nMore decimal digits does not always mean bigger.","lineHeight":1.25},
    {"id":"money_text","type":"text","x":626,"y":410,"width":420,"height":190,"angle":0,"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["money"],"frameId":null,"roundness":null,"seed":76205,"version":3,"versionNonce":86205,"isDeleted":false,"boundElements":null,"updated":3,"link":null,"locked":false,"text":"4. Money: line up decimal points\nA toy costs $6.87. Maya pays $10.00.\n$10.00 - $6.87 = $3.13\n1000c - 687c = 313c\n313c is a check, not the answer\nfinal gate: $ + 2 decimals\nfinal answer must be $3.13","fontSize":21,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4. Money: line up decimal points\nA toy costs $6.87. Maya pays $10.00.\n$10.00 - $6.87 = $3.13\n1000c - 687c = 313c\n313c is a check, not the answer\nfinal gate: $ + 2 decimals\nfinal answer must be $3.13","lineHeight":1.25}
