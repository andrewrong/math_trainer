    {"id":"place_text","type":"text","x":68,"y":174,"width":470,"height":100,"angle":0,"strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["place"],"frameId":null,"roundness":null,"seed":76202,"version":1,"versionNonce":86202,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"4.307 has no hundredths.\n4.307 = 4 + 3/10 + 0/100 + 7/1000","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4.307 has no hundredths.\n4.307 = 4 + 3/10 + 0/100 + 7/1000","lineHeight":1.25},
