    {"id":"scale_text","type":"text","x":74,"y":636,"width":1000,"height":110,"angle":0,"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["scale"],"frameId":null,"roundness":null,"seed":60502,"version":1,"versionNonce":70502,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"5. Scale audit before trend\nSame data, different vertical scale. A steep line is a clue, not proof.\nEvidence sentence: Sales increased from 92 to 96, by 4 items.\nClaim + actual values + unit beats \"the line looks steep\". 92 -> 96 = +4 items.","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5. Scale audit before trend\nSame data, different vertical scale. A steep line is a clue, not proof.\nEvidence sentence: Sales increased from 92 to 96, by 4 items.\nClaim + actual values + unit beats \"the line looks steep\". 92 -> 96 = +4 items.","lineHeight":1.25}
