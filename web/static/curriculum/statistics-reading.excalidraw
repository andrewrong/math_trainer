    {"id":"ops_text","type":"text","x":804,"y":292,"width":310,"height":160,"angle":0,"strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["ops"],"frameId":null,"roundness":null,"seed":60402,"version":1,"versionNonce":70402,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"4. Choose the operation\nExact value: read one point\nDifference: subtract\nTotal: add rows\nTrend: direction + amount + unit\nDo not connect unrelated categories with a line.","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4. Choose the operation\nExact value: read one point\nDifference: subtract\nTotal: add rows\nTrend: direction + amount + unit\nDo not connect unrelated categories with a line.","lineHeight":1.25},
